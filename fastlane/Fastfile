opt_out_usage

default_platform(:ios)

platform :ios do
  desc "Download current metadata + screenshots from App Store Connect into /tmp/asc-live"
  lane :download_state do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    sh("rm -rf /tmp/asc-live && mkdir -p /tmp/asc-live")

    deliver(
      api_key: api_key,
      run_precheck_before_submit: false,
      metadata_path: "/tmp/asc-live/metadata",
      screenshots_path: "/tmp/asc-live/screenshots",
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: false,
      force: true
    )
  end

  desc "Fill whats_new + promotional_text on deprecated locales that ASC still requires"
  lane :fill_deprecated_locales do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    app = Spaceship::ConnectAPI::App.find("com.jackwallner.baseball")
    version = app.get_edit_app_store_version
    UI.user_error!("No editable version found") unless version

    release_notes = "Now includes year-over-year metric tracking: tap the year toggle on any player profile to see how their percentiles shifted season to season. Also includes player comparison mode and historical season loading for Pro subscribers."
    promo_text = "Visual Statcast percentile rankings and MLB Savant-style metrics. See where every qualified player ranks across Hitting, Pitching, Fielding, and Running."

    deprecated = %w[bn-BD gu-IN kn-IN ml-IN mr-IN or-IN pa-IN sl-SI ta-IN te-IN ur-PK]

    version.get_app_store_version_localizations.each do |loc|
      next unless deprecated.include?(loc.locale)
      UI.message("Filling #{loc.locale}...")
      loc.update(attributes: { whatsNew: release_notes, promotionalText: promo_text })
    end

    UI.success("All deprecated locales filled.")
  end

  desc "Upload screenshots and metadata to App Store Connect (fastlane 2.234+)"
  lane :upload_metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    version = ENV["ASC_APP_VERSION"]
    UI.user_error!("Set ASC_APP_VERSION (run: eval \"$(python3 scripts/asc-ensure-draft-version.py | grep '^export ')\")") unless version && !version.empty?

    skip_shots = ENV.fetch("SKIP_SCREENSHOTS", "false") == "true"

    deliver(
      api_key: api_key,
      app_version: version,
      skip_app_version_update: true,
      force: true,
      ignore_language_directory_validation: true,
      precheck_include_in_app_purchases: false,
      version_check_wait_retry_limit: 7,
      skip_binary_upload: true,
      skip_screenshots: skip_shots,
      overwrite_screenshots: !skip_shots,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      app_review_information: {
        first_name: "Jack",
        last_name: "Wallner",
        email: "jackwallner@gmail.com",
        demo_user: "N/A (no login, no account system)",
        demo_password: "",
        notes: <<~NOTES
          StatScout is a read-only baseball statistics viewer with no user accounts or sign-in.

          Core flow:
          1. Launch app. New users see onboarding; returning users land on the Stats board
          2. Scroll the leaderboard of ~800+ players with percentile rankings
          3. Tap a player for a profile with visual metric bars, standard stats, and year compare
          4. Filter by Hitting, Pitching, Fielding, Running categories
          5. Trends tab ranks the league by recent form; Teams tab browses rosters;
             Compare stacks two players head-to-head
          6. The Stats tab's View menu holds Leaders and Best & Worst per metric

          StatScout+ features (IAP via RevenueCat):
          - Historical seasons, player comparisons, year-over-year tracking
          - Test with Sandbox account via RevenueCat

          New in this version: postseason data. Any board can be switched
          between "Regular Season" and "Postseason" from the season menu on the
          Stats and team screens. Before the first playoff game is ingested,
          the menu keeps a visible but disabled "Postseason (after first playoff
          game)" item so the feature is discoverable. Once playoff data lands,
          it becomes selectable and the rows appear.

          Also new: a postseason card on the Stats board. It is merchandising
          only and grants nothing. For a free user its button opens the same
          StatScout+ pitch reachable from the existing upgrade entry points; for
          a subscriber it switches the boards to the postseason. There is no
          promo code, no discount, and no price quoted anywhere in the card: all
          prices come from StoreKit.

          3.1.2(c), carried forward from the 1.4.4 review: the total billed
          amount is the most conspicuous pricing element in every purchase flow.
          Each purchase button has the price directly above it, set larger and
          heavier than any other pricing text on the screen, including the
          free-trial wording on the button and the small print beneath it.
          Onboarding shows "$5.99 / month" above its button; the trial sheet and
          the plan sheet show the selected plan's price the same way. That
          pricing slot is a fixed height, so it cannot move the purchase button
          while StoreKit is still loading.

          2.1(b), also carried forward: both auto-renewable subscriptions
          (com.jackwallner.baseball.pro.monthly and .yearly) are approved and
          live, as is the non-consumable com.jackwallner.baseball.pro.

          Guideline 4, from the 1.5.0 review on iPad Air 11-inch (M4): fixed.
          StatScout is an iPhone app, so on iPad it runs in the iPhone
          compatibility window, which is 375x622pt, around 140pt shorter than
          the iPhone the onboarding flow had been laid out for. The flow now
          measures the height it is actually given and sizes itself to it, so
          every heading, every line of body copy and all four bullets are
          visible on each page at that window size, with nothing truncated,
          clipped or overlapped. The paging dots moved out of the card and into
          the header, where they can no longer sit on top of a bullet. The same
          fix covers iPhone SE, which has the same short canvas.

          Guideline 2.1(b), the purchase error from the 1.5.0 review: fixed.
          Two things could put a red message under a purchase button. Dismissing
          Apple's confirm sheet was reported as "Purchase cancelled", which
          reads as a failure rather than a choice, and cancelling is now silent. A
          genuine failure showed whatever message was last set by any store
          operation, including a product-load failure from launch, so a purchase
          could inherit an unrelated "couldn't load subscription options" line;
          purchase failures now carry their own StoreKit-specific copy. The
          offering also retries on a slow or VPN'd network, and a CTA tapped
          before products finish loading now loads them and buys, instead of
          falling through to the plan picker's error state.

          Known: Light mode only. No shadows. No accounts. No social features.
        NOTES
      },
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end

  desc "Submit the draft version for App Store review (metadata already uploaded)"
  lane :submit_review do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    version = ENV["ASC_APP_VERSION"]
    UI.user_error!("Set ASC_APP_VERSION") unless version && !version.empty?
    build_number = ENV["ASC_BUILD_NUMBER"]
    UI.user_error!("Set ASC_BUILD_NUMBER") unless build_number && !build_number.empty?

    deliver(
      api_key: api_key,
      app_version: version,
      build_number: build_number,
      skip_app_version_update: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
      # Matches upload_metadata. The 11 deprecated locale directories are still
      # required by ASC but rejected by deliver's validator, and this lane
      # uploads no metadata anyway, so the directory check has nothing to guard.
      ignore_language_directory_validation: true,
      submit_for_review: true,
      # Manual release. The price ladder changes on its own schedule, so an
      # approval must never put a version on sale by itself.
      automatic_release: false,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
  end
end
