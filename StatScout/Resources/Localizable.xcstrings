    "Tap a player to load them into a slot below.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a player to load them into a slot below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un jugador para añadirlo a un espacio de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un joueur pour le placer dans un emplacement ci-dessous."
          }
        },
