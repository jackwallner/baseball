    "The Trends board, recent form, head-to-head matchups, and every season back to 2015. The full Statcast picture on every player.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Trends board, recent form, head-to-head matchups, and every season back to 2015. The full Statcast picture on every player."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tablero de Tendencias, la forma reciente, los duelos cara a cara y cada temporada desde 2015. El panorama completo de Statcast de cada jugador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tableau Tendances, la forme récente, les duels directs et toutes les saisons depuis 2015. Le profil Statcast complet de chaque joueur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La classifica delle tendenze, la forma recente, i confronti diretti e ogni stagione dal 2015. Il quadro Statcast completo di ogni giocatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トレンドボード、最近の調子、選手同士の比較、2015年以降の全シーズン。全選手のStatcast指標を網羅。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O quadro de Tendências, a forma recente, os confrontos diretos e cada temporada desde 2015. O panorama completo do Statcast de cada jogador."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "趨勢榜、近期表現、正面對決，以及回溯至 2015 年的所有球季。掌握每位球員完整的 Statcast 數據。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trends-Board, aktuelle Form, direkte Duelle und jede Saison ab 2015. Das vollständige Statcast-Bild jedes Spielers."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트렌드 보드, 최근 폼, 맞대결, 2015년부터 모든 시즌. 모든 선수의 전체 Statcast 기록."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "趋势榜、近期状态、正面对比，以及 2015 年以来的每个赛季。全面了解每位球员的 Statcast 数据。"
          }
        }
      }
    },
