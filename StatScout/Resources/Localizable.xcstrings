    "Compare any player's percentile rankings across any two seasons. See what changed, what held, and where they're headed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare any player's percentile rankings across any two seasons. See what changed, what held, and where they're headed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara los percentiles de cualquier jugador entre dos temporadas. Mira qué cambió, qué se mantuvo y hacia dónde va."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez les classements en centiles d’un joueur sur deux saisons. Voyez ce qui a changé, ce qui est resté stable et la tendance qui se dessine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta i percentili di qualsiasi giocatore tra due stagioni. Scopri cosa è cambiato, cosa è rimasto e dove sta andando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意の2シーズンで選手のパーセンタイルを比較。何が変わり、何が変わらず、どこへ向かっているかがわかります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare os percentis de qualquer jogador entre duas temporadas. Veja o que mudou, o que se manteve e qual é a tendência."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比較任一球員在兩個球季的百分位排名，看看哪些改變、哪些維持，以及未來走向。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche die Perzentil-Ranglisten eines Spielers über zwei beliebige Saisons. Sieh, was sich verändert hat, was gleich blieb und wohin die Entwicklung geht."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 시즌의 선수 백분위 순위를 비교해 무엇이 달라지고 유지됐는지, 다음엔 어떻게 될지 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比较球员任意两个赛季的百分位排名，查看哪些数据变化、哪些保持稳定，以及走势如何。"
          }
        }
      }
    },
