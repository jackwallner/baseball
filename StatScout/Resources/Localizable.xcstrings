            "state": "translated",
            "value": "選手をタップして下の枠に入れます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um jogador para adicioná-lo a um espaço abaixo."
          }
