    "%@ ranks hitters with 3.1 PA per team game.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ranks hitters with 3.1 PA per team game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ clasifica a bateadores con 3,1 PA por juego del equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ classe les frappeurs avec 3,1 PA par match de l’équipe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ classifica i battitori con 3,1 PA per partita della squadra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は、チーム1試合あたり3.1 PA以上の打者をランク付けします。"
          }
        },
        "pt-BR": {
