          }
        }
      }
    },
    "The Trends board: who's heating up and cooling off, league-wide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Trends board: who's heating up and cooling off, league-wide"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tablero de Tendencias: quién está en racha y quién va a la baja en toda la liga"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tableau Tendances : qui monte et qui descend, dans toute la ligue"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La classifica delle tendenze: chi è in crescita e chi è in calo in tutta la lega"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トレンドボード:リーグ全体で誰が上り調子で誰が下り調子か"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O quadro de Tendências: quem está em alta e quem está em baixa na liga"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "趨勢榜：全聯盟誰在升溫、誰在降溫"
          }
        }
      }
    },
    "The league leader and the league trailer on every Statcast metric, side by side, in one board.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The league leader and the league trailer on every Statcast metric, side by side, in one board."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El líder y el último de la liga en cada métrica de Statcast, lado a lado, en un solo tablero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le leader et le dernier de la ligue sur chaque mesure Statcast, côte à côte, dans un seul tableau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ogni metrica Statcast, il migliore e il peggiore della lega, affiancati in un’unica classifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Statcastの全指標で、リーグのトップと最下位を1つのボードに並べて表示。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O líder e o último da liga em cada métrica do Statcast, lado a lado, em um só quadro."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每項 Statcast 指標的聯盟第一與墊底，並排呈現在同一個榜單。"
          }
        }
      }
    },
    "The new Trends board ranks the biggest movers across the league, not just the names already at the top.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new Trends board ranks the biggest movers across the league, not just the names already at the top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo tablero de Tendencias clasifica a quienes más suben o bajan en la liga, no solo a quienes ya están arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouveau tableau Tendances classe les joueurs dont les stats évoluent le plus dans toute la ligue, pas seulement ceux déjà en tête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nuova classifica delle tendenze ordina chi sta salendo o scendendo di più nella lega, non solo i nomi già in cima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいトレンドボードでは、すでに上位にいる選手だけでなく、リーグ全体の選手を成績の変動幅順に表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O novo quadro de Tendências classifica os jogadores pelas maiores variações na liga, não só os nomes que já estão no topo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全新趨勢榜會排出全聯盟變化幅度最大的球員，不只聚焦原本排名前段的球員。"
          }
        }
      }
    },
    "The playoff games are in, but the latest player lines have not landed yet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The playoff games are in, but the latest player lines have not landed yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los juegos de playoffs ya se jugaron, pero las estadísticas más recientes de los jugadores aún no están disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats des matchs des séries sont disponibles, mais les dernières stats des joueurs ne le sont pas encore."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partite dei playoff sono state giocate, ma le ultime statistiche dei giocatori non sono ancora arrivate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレーオフの試合結果は出ていますが、最新の選手成績はまだ反映されていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os jogos da pós-temporada já aconteceram, mas os dados mais recentes dos jogadores ainda não estão disponíveis."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "季後賽比賽已打完，但最新的球員數據尚未更新。"
          }
        }
      }
    },
    "The playoff games are in, but the latest team lines have not landed yet.": {
