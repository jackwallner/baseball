          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "xwOBAやBarrel%からAVG、ERA、盗塁まで、選手やチームの高度な指標と基本成績を並べ替え。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
