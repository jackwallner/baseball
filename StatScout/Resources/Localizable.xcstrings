    "Showing saved data. Pull to refresh to try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing saved data. Pull to refresh to try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando datos guardados. Desliza para actualizar e intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichage des données enregistrées. Tirez pour actualiser et réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizzazione dati salvati. Trascina per aggiornare e riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのデータを表示中です。下に引っ張って再読み込みしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando dados salvos. Puxe para atualizar e tentar de novo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示已儲存的資料。下拉重新整理即可再試一次。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Daten werden angezeigt. Zieh zum Aktualisieren und versuch es erneut."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 데이터를 표시합니다. 당겨서 새로고침한 뒤 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在显示已保存的数据。下拉刷新后重试。"
          }
        }
      }
    },
