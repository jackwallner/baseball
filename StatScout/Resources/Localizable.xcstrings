    "Percentiles vs. %@ regular season. Ranks players with 3.1 PA or 1 IP per team game.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Percentiles vs. %@ regular season. Ranks players with 3.1 PA or 1 IP per team game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Percentiles frente a la temporada regular de %@. Clasifica a los jugadores que alcanzan 3,1 PA o 1 IP por juego de su equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Centiles vs saison régulière %@. Classe les joueurs avec 3,1 PA ou 1 IP par match d’équipe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Percentili rispetto alla stagione regolare %@. Classifica i giocatori con 3,1 PA o 1 IP per ogni partita della squadra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@年レギュラーシーズンとの比較(パーセンタイル)。チーム1試合あたり3.1打席または1投球回以上の選手が対象です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Percentis vs. temporada regular %@. Classifica jogadores com 3,1 PA ou 1 IP por jogo do time."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與 %@ 例行賽相比的百分位。每場球隊比賽至少 3.1 PA 或 1 IP 的球員才列入排名。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Perzentile im Vergleich zur Regular Season %@. Spieler mit 3,1 PA oder 1 IP pro Teamspiel werden eingestuft."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 정규 시즌 대비 백분위. 팀 경기당 3.1 PA 또는 1 IP 이상인 선수를 순위에 반영합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与 %@ 常规赛相比的百分位。按每队每场 3.1 PA 或 1 IP 的球员排名。"
          }
        }
      }
    },
    "Pick a player to see how their percentile rankings moved across every season.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a player to see how their percentile rankings moved across every season."
          }
        },
        "es": {
