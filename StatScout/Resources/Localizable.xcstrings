    "%@ doesn't have enough of a prior window to compare against. Try another stat or a longer window.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doesn't have enough of a prior window to compare against. Try another stat or a longer window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene suficientes datos del periodo anterior para comparar. Prueba con otra estadística o un periodo más largo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne dispose pas d’une période précédente assez longue pour permettre la comparaison. Essayez une autre stat ou une période plus longue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha un periodo precedente sufficiente per il confronto. Prova un’altra statistica o un periodo più lungo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は比較対象となる過去の期間が不足しています。別の指標か、より長い期間をお試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não tem período anterior suficiente para comparar. Tente outra estatística ou um período maior."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的前一個區間資料不足，無法比較。請改用其他數據或更長的區間。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat im vorherigen Zeitraum nicht genug Daten zum Vergleichen. Wähle eine andere Statistik oder einen längeren Zeitraum."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 이전 기간의 데이터가 부족해 비교할 수 없습니다. 다른 기록이나 더 긴 기간을 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的前一时间段数据不足，无法比较。请换一项数据或延长时间范围。"
          }
        }
      }
    },
