    "Stack any two players head-to-head across every Statcast metric: xwOBA, Barrel%, Sprint Speed, and more.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stack any two players head-to-head across every Statcast metric: xwOBA, Barrel%, Sprint Speed, and more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfrenta a dos jugadores en todas las métricas de Statcast: xwOBA, Barrel%, velocidad de carrera y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez deux joueurs sur toutes les mesures Statcast : xwOBA, Barrel%, vitesse de sprint et plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta due giocatori su ogni metrica Statcast: xwOBA, Barrel%, velocità di scatto e altro."
          }
        },
        "ja": {
          "stringUnit": {
