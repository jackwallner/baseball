    "Last 7 / 15 / 30 day form, head-to-head matchups, every roster. The full picture, not just season totals.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last 7 / 15 / 30 day form, head-to-head matchups, every roster. The full picture, not just season totals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendimiento de los últimos 7 / 15 / 30 días, duelos cara a cara y todas las plantillas. El panorama completo, no solo los totales de la temporada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forme sur 7 / 15 / 30 jours, duels directs, tous les effectifs. Le tableau complet, pas seulement les totaux de la saison."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forma degli ultimi 7 / 15 / 30 giorni, confronti diretti, ogni roster. Il quadro completo, non solo i totali stagionali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近7/15/30日の調子、選手同士の直接比較、全ロースター。シーズン通算だけではない全体像を。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desempenho nos últimos 7 / 15 / 30 dias, confrontos diretos e todos os elencos. O panorama completo, não só os totais da temporada."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "近 7 / 15 / 30 天表現、正面對決、所有球員名單。不只球季總數，更是完整面貌。"
          }
        }
      }
    },
