    "Sort advanced and traditional stats across players and teams, from xwOBA and Barrel% to AVG, ERA, and stolen bases.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort advanced and traditional stats across players and teams, from xwOBA and Barrel% to AVG, ERA, and stolen bases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena las estadísticas avanzadas y tradicionales de jugadores y equipos, desde xwOBA y Barrel% hasta AVG, ERA y bases robadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
