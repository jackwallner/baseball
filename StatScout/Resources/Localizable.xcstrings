    "Put %@ beside any other season and see what moved.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put %@ beside any other season and see what moved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon %@ junto a cualquier otra temporada y mira qué cambió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez %@ à n’importe quelle autre saison pour voir ce qui a changé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti %@ accanto a qualsiasi altra stagione e scopri cosa è cambiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@年を他のシーズンと並べて、何が変わったかを確認。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque %@ ao lado de qualquer outra temporada e veja o que mudou."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 %@ 與任何其他球季並排，看看哪裡有變化。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle %@ neben eine beliebige andere Saison und sieh, was sich verändert hat."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 다른 시즌과 비교해 무엇이 달라졌는지 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 %@ 与任意赛季并排比较，看看有哪些变化。"
          }
        }
      }
    },
