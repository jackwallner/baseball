          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia a cualquiera de los dos jugadores y la temporada de cada uno. Compara las métricas que comparten en paralelo y descubre al instante quién destaca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez le joueur ou l’année de chaque côté. Comparez toutes les mesures communes côte à côte, avec le gagnant indiqué aussitôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia uno dei due giocatori e uno dei due anni. Vedi ogni metrica in comune affiancata, con il vincitore evidenziato subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選手も年も自由に変更。共通する指標をすべて並べて、勝者がひと目でわかります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troque qualquer jogador e qualquer ano. Veja cada métrica em comum lado a lado, com o vencedor destacado na hora."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可更換任一球員與任一年份。並排檢視所有共同指標，勝者一目了然。"
          }
        }
      }
    },
