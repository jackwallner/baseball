    "Change either player and either year. See every shared metric side by side, with the winner called out instantly.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change either player and either year. See every shared metric side by side, with the winner called out instantly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia a cualquiera de los dos jugadores y la temporada de cada uno. Compara las métricas que comparten en paralelo y descubre al instante quién destaca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez le joueur ou l’année de chaque côté. Comparez toutes les mesures communes côte à côte, avec le gagnant indiqué aussitôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia uno dei due giocatori e uno dei due anni. Vedi ogni metrica in comune affiancata, con il vincitore evidenziato subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選手も年も自由に変更。共通する指標をすべて並べて、勝者がひと目でわかります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troque qualquer jogador e qualquer ano. Veja cada métrica em comum lado a lado, com o vencedor destacado na hora."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可更換任一球員與任一年份。並排檢視所有共同指標，勝者一目了然。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere einen Spieler oder ein Jahr und sieh alle gemeinsamen Statistiken direkt nebeneinander. Der Gewinner wird sofort hervorgehoben."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선수와 연도를 바꾸며 공통 기록을 나란히 비교하고, 앞선 선수를 바로 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更换任意球员或赛季，并排查看双方共有的指标，领先者会立即标出。"
          }
        }
      }
    },
