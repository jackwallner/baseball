    "Not affiliated with, endorsed by, or sponsored by Major League Baseball, MLB Advanced Media, MLBPA, or any team. Team names and abbreviations are used for identification only. All trademarks are property of their respective owners.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not affiliated with, endorsed by, or sponsored by Major League Baseball, MLB Advanced Media, MLBPA, or any team. Team names and abbreviations are used for identification only. All trademarks are property of their respective owners."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No está afiliada, respaldada ni patrocinada por Major League Baseball, MLB Advanced Media, la MLBPA ni ningún equipo. Los nombres y abreviaturas de los equipos se usan solo para identificarlos. Todas las marcas pertenecen a sus respectivos propietarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette application n’est affiliée à la Major League Baseball, à MLB Advanced Media, à la MLBPA ni à aucune équipe. Elle n’est ni approuvée ni parrainée par ces entités. Les noms et abréviations des équipes servent uniquement à l’identification. Toutes les marques appartiennent à leurs propriétaires respectifs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app non è affiliata a Major League Baseball, MLB Advanced Media, MLBPA o ad alcuna squadra, né è approvata o sponsorizzata da queste organizzazioni. I nomi e le abbreviazioni delle squadre sono usati solo a fini identificativi. Tutti i marchi appartengono ai rispettivi proprietari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本アプリはメジャーリーグベースボール、MLB Advanced Media、MLBPA、各球団とは提携・承認・後援関係にありません。球団名と略称は識別のためにのみ使用しています。すべての商標はそれぞれの所有者に帰属します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é afiliado, endossado nem patrocinado pela Major League Baseball, MLB Advanced Media, MLBPA ou qualquer time. Nomes e abreviações de times são usados apenas para identificação. Todas as marcas pertencem aos respectivos proprietários."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 與美國職棒大聯盟、MLB Advanced Media、MLBPA 或任何球隊無關，亦未獲其認可或贊助。球隊名稱與縮寫僅用於識別。所有商標均屬其各自擁有者。"
          }
        }
      }
    },
