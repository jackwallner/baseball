    "Load historical data to explore past seasons, year-over-year trends, and more.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load historical data to explore past seasons, year-over-year trends, and more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga los datos históricos para explorar temporadas pasadas, tendencias interanuales y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargez les données historiques pour explorer les saisons passées, les tendances d’une année à l’autre et plus encore."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica i dati storici per esplorare le stagioni passate, le tendenze anno su anno e altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去データを読み込んで、過去のシーズンや年ごとの推移などを確認できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregue os dados históricos para explorar temporadas passadas, tendências ano a ano e mais."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "載入歷史資料，探索過往球季、逐年趨勢等內容。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade historische Daten und entdecke vergangene Saisons, Trends im Jahresvergleich und mehr."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "과거 시즌, 연도별 추이 등을 살펴볼 수 있도록 기록을 불러오세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载历史数据，探索过往赛季、逐年趋势等内容。"
          }
        }
      }
    },
