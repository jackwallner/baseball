    "Switch any board to Postseason from the season menu to see playoff game logs and how each roster is performing right now.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch any board to Postseason from the season menu to see playoff game logs and how each roster is performing right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia cualquier tablero a Postemporada desde el menú de temporada para ver las estadísticas de cada juego de playoffs y el rendimiento actual de cada plantilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis le menu Saison, passez n’importe quel tableau en mode Séries pour consulter les performances match par match et voir la forme actuelle de chaque effectif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa qualsiasi classifica ai playoff dal menu della stagione per vedere i tabellini delle partite e l’andamento attuale di ogni roster."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シーズンメニューから任意のボードをポストシーズンに切り替えると、試合ログと各ロースターの現在の調子を確認できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mude qualquer quadro para Pós-temporada no menu de temporada para ver o histórico dos jogos e o desempenho atual de cada elenco."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在球季選單中將任何榜單切換為季後賽，即可查看季後賽逐場紀錄與各隊球員目前的表現。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle im Saisonmenü bei jeder Rangliste die Playoffs aus, um Spielprotokolle und die aktuelle Form der Teams zu sehen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시즌 메뉴에서 포스트시즌을 선택해 경기 기록과 각 팀의 현재 폼을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在赛季菜单中将任意排行榜切换到季后赛，查看季后赛比赛记录和各队当前状态。"
          }
        }
      }
    },
