    "Follow players to keep them one tap from a comparison, and to spot them on the Trends board.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow players to keep them one tap from a comparison, and to spot them on the Trends board."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue a los jugadores para tenerlos a mano en las comparaciones y verlos en el tablero de Tendencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez des joueurs pour les ajouter en un geste à une comparaison et les repérer dans le tableau Tendances."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui i giocatori per confrontarli con un tocco e ritrovarli nella classifica Tendenze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選手をフォローすると、ワンタップで比較でき、トレンドボードでも見つけやすくなります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga jogadores para compará-los com um toque e vê-los no painel de Tendências."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "追蹤球員後，只需輕點即可比較，也能在趨勢榜上快速找到他們。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folge Spielern, um sie mit einem Fingertipp zu vergleichen und im Trends-Board wiederzufinden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선수를 팔로우하면 비교까지 한 번에 이동하고 트렌드 보드에서도 찾을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关注球员后，可在对比中一键查看，也能在趋势榜上找到他们。"
          }
        }
      }
    },
    "Four tabs cover every angle of the game. See what's happening across the league in seconds.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four tabs cover every angle of the game. See what's happening across the league in seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro pestañas cubren cada ángulo del juego. Mira qué pasa en toda la liga en segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre onglets couvrent tous les aspects du jeu. Voyez ce qui se passe dans la ligue en quelques secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quattro schede coprono ogni aspetto del gioco. Scopri cosa succede in tutta la lega in pochi secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4つのタブで野球のあらゆる側面をカバー。リーグ全体の動きを数秒でつかめます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatro abas cobrem todos os ângulos do jogo. Veja o que acontece na liga inteira em segundos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "四個分頁涵蓋比賽的各個面向，幾秒內掌握全聯盟動態。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier Tabs zeigen alle Facetten des Spiels. Sieh in Sekunden, was in der Liga passiert."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네 개 탭으로 경기의 다양한 면을 확인하고 리그 상황을 빠르게 살펴보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "四个标签涵盖比赛的各个方面。几秒钟内了解联盟动态。"
          }
        }
      }
    },
