    "Nobody clears the Regulars minimum on %@ in this window. Try a lower qualifier or a longer window.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody clears the Regulars minimum on %@ in this window. Try a lower qualifier or a longer window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie alcanza el mínimo para estar entre los habituales en %@ durante este periodo. Prueba con un umbral más bajo o un periodo más largo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne n’atteint le seuil des joueurs réguliers sur %@ pendant cette période. Essayez un seuil plus bas ou une période plus longue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno raggiunge la soglia minima da titolare per %@ in questo periodo. Prova una soglia più bassa o un periodo più lungo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間、「%@」でレギュラー基準を満たす選手はいません。基準を下げるか、期間を長くしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém atinge o mínimo de Titulares em %@ neste período. Tente um mínimo menor ou um período maior."
