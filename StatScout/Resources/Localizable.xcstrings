    "Season numbers tell you who's good. StatScout+ tells you who's good right now, and lets you prove it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Season numbers tell you who's good. StatScout+ tells you who's good right now, and lets you prove it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los números de la temporada dicen quién es bueno. StatScout+ dice quién es bueno ahora mismo y te deja demostrarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chiffres de la saison disent qui est bon. StatScout+ dit qui est bon en ce moment, et vous permet de le prouver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I numeri stagionali dicono chi è bravo. StatScout+ dice chi è bravo adesso e ti permette di dimostrarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シーズンの数字は「誰が良いか」を教えてくれます。StatScout+は「今、誰が良いか」を教え、それを裏付けてくれます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os números da temporada mostram quem é bom. O StatScout+ mostra quem está jogando bem agora e ajuda você a provar isso."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "球季數字告訴你誰很強，StatScout+ 告訴你誰現在表現出色，還能幫你證明。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisonwerte zeigen, wer gut ist. StatScout+ zeigt, wer gerade gut ist, und liefert den Beleg."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시즌 기록은 누가 잘하는지 보여줍니다. StatScout+는 지금 잘하는 선수와 그 근거를 보여줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "赛季数据告诉你谁表现好。StatScout+ 告诉你谁当下状态好，并用数据证明。"
          }
        }
      }
    },
