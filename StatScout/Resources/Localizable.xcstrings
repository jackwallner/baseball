        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此區間內沒有球員達到 %@ 的主力門檻。請降低門檻或拉長區間。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand erreicht den Stammspieler-Mindestwert für %@ in diesem Zeitraum. Wähle einen niedrigeren Mindestwert oder einen längeren Zeitraum."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기간에는 %@의 주전 선수 기준을 충족한 선수가 없습니다. 최소 기준을 낮추거나 기간을 늘리세요."
