    "Baseball percentile rankings built for a fast mobile view. Every qualified player, every metric, always up to date.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Baseball percentile rankings built for a fast mobile view. Every qualified player, every metric, always up to date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rankings de percentiles de béisbol, fáciles de consultar en el móvil. Todos los jugadores calificados, todas las métricas, siempre al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des classements en centiles du baseball pensés pour le mobile. Chaque joueur qualifié, chaque mesure, toujours à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Classifiche di baseball basate sui percentili, pensate per smartphone. Dati sempre aggiornati per ogni giocatore qualificato e ogni metrica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホで素早く見られる野球のパーセンタイルランキング。規定に達した全選手の全指標を、常に最新の状態で確認できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rankings de percentis de beisebol feitos para o celular. Todos os jogadores qualificados, todas as métricas, sempre atualizados."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專為手機設計的棒球百分位排行，涵蓋所有符合資格的球員與指標，並隨時更新。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baseball-Perzentilrankings für die schnelle Ansicht unterwegs. Jeder qualifizierte Spieler, jede Statistik, immer aktuell."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠르게 볼 수 있도록 야구 백분위 순위를 모바일에 맞췄습니다. 자격을 갖춘 모든 선수와 기록을 최신으로 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为移动端打造的棒球百分位排名。涵盖所有达标球员和指标，并保持最新。"
          }
        }
      }
    },
