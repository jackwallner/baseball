    "Totals add up the current roster's season lines, so a player traded in July brings his whole year with him.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Totals add up the current roster's season lines, so a player traded in July brings his whole year with him."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los totales suman las estadísticas de temporada de la plantilla actual, así que un jugador que cambia de equipo en julio aporta sus estadísticas de toda la temporada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les totaux additionnent les stats de la saison des joueurs de l’effectif actuel : un joueur échangé en juillet apporte donc ses stats pour toute la saison."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I totali sommano le statistiche stagionali del roster attuale, quindi un giocatore ceduto a luglio porta con sé tutta la sua stagione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合計は現在のロースターのシーズン成績を足し合わせたもので、7月にトレードされた選手は1年分が含まれます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os totais somam as estatísticas da temporada do elenco atual, então um jogador trocado em julho mantém os números da temporada inteira."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "總計是將目前名單的球季數據相加，因此 7 月被交易的球員會帶著整年數據。"
          }
        }
      }
    },
    "Track how every player ranked since 2015, plus the year-over-year trends behind today's leaders.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track how every player ranked since 2015, plus the year-over-year trends behind today's leaders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue la posición de cada jugador en la clasificación desde 2015 y las tendencias interanuales de los líderes actuales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez le classement de chaque joueur depuis 2015 et les tendances annuelles qui expliquent le classement des leaders actuels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui l’andamento in classifica di ogni giocatore dal 2015 e le tendenze anno su anno dei giocatori in testa oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2015年以降の全選手の順位に加え、現在の上位選手の年ごとの推移も追えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe a posição de cada jogador no ranking desde 2015 e veja as tendências ano a ano por trás dos líderes atuais."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "追蹤每位球員自 2015 年以來的排名，以及目前領先者背後的逐年趨勢。"
          }
        }
      }
    },
