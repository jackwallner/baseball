    "StatScout+ unlocks side-by-side player comparisons across every metric. See who leads in xwOBA, Barrel%, Sprint Speed, and more.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StatScout+ unlocks side-by-side player comparisons across every metric. See who leads in xwOBA, Barrel%, Sprint Speed, and more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "StatScout+ desbloquea comparaciones de jugadores lado a lado en todas las métricas. Mira quién lidera en xwOBA, Barrel%, velocidad de carrera y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "StatScout+ débloque les comparaisons de joueurs côte à côte sur toutes les mesures. Voyez qui mène en xwOBA, Barrel%, vitesse de sprint et plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "StatScout+ sblocca i confronti affiancati tra giocatori su ogni metrica. Scopri chi è in testa in xwOBA, Barrel%, velocità di scatto e altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "StatScout+なら、全指標で選手を並べて比較できます。xwOBA、Barrel%、スプリントスピードなどで誰がリードしているかを確認。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O StatScout+ libera comparações lado a lado de jogadores em todas as métricas. Veja quem lidera em xwOBA, Barrel%, velocidade de sprint e mais."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "StatScout+ 可並排比較球員的所有指標，看看誰在 xwOBA、Barrel%、衝刺速度等項目領先。"
          }
        }
      }
    },
