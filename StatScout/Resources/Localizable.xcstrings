    "Advanced and standard stats for every club, a roster you can rank by any metric over any window, and side-by-side comparisons for every squad.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced and standard stats for every club, a roster you can rank by any metric over any window, and side-by-side comparisons for every squad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estadísticas avanzadas y tradicionales de cada club, plantillas que puedes ordenar por cualquier métrica y periodo, y comparativas en paralelo entre equipos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stats avancées et classiques de chaque club, un effectif classable par n’importe quelle mesure et période, et des comparaisons côte à côte de chaque équipe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistiche avanzate e standard di ogni club, un roster ordinabile per qualsiasi metrica e periodo e confronti affiancati di ogni squadra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全球団の高度な指標と標準指標、指標や期間を選んで順位付けできるロースター、チーム同士の比較。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estatísticas avançadas e padrão de cada time, um elenco classificável por qualquer métrica e período e comparações lado a lado de cada time."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每支球隊的進階與標準數據、可依任何指標與區間排名的球員名單，以及球隊並排比較。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweiterte und klassische Statistiken für jedes Team, Kader sortiert nach beliebiger Statistik und Zeitraum sowie direkte Vergleiche aller Teams."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 팀의 고급 및 기본 기록, 원하는 기록과 기간별 순위, 팀 간 비교를 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看各队高级与标准数据，按任意指标和时间范围排列阵容，并直接比较球队。"
          }
        }
      }
    },
