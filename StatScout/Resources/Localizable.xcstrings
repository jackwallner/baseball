            "state": "translated",
            "value": "與 %@ 例行賽相比的百分位。每場球隊比賽至少 3.1 PA 或 1 IP 的球員才列入排名。"
          }
        }
      }
    },
    "Pick a player to see how their percentile rankings moved across every season.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a player to see how their percentile rankings moved across every season."
          }
        },
        "es": {
          "stringUnit": {
