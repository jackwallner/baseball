    "Tap a player to see their stats. Head-to-head needs StatScout+.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a player to see their stats. Head-to-head needs StatScout+."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un jugador para ver sus estadísticas. El cara a cara requiere StatScout+."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un joueur pour voir ses stats. Le face-à-face nécessite StatScout+."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un giocatore per vedere le sue statistiche. Il testa a testa richiede StatScout+."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選手をタップすると成績を表示します。選手同士の比較にはStatScout+が必要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um jogador para ver suas estatísticas. Os confrontos diretos exigem o StatScout+."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選球員查看數據。正面對決需要 StatScout+。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Spieler, um seine Statistiken zu sehen. Für direkte Duelle brauchst du StatScout+."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선수를 눌러 기록을 확인하세요. 맞대결 비교에는 StatScout+가 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按球员查看数据。正面对比需要 StatScout+。"
          }
        }
      }
    },
