    "Calendar days, not games · G is games played in the window.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar days, not games · G is games played in the window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Días naturales, no juegos · G son los juegos disputados en el periodo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jours calendaires, pas matchs · G = matchs joués sur la période."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giorni di calendario, non partite · G indica le partite giocate nel periodo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試合数ではなく暦日 · Gは期間内の出場試合数。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dias corridos, não jogos · G são os jogos disputados no período."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以日曆天數計算，非比賽場數 · G 為區間內出賽場數。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendertage, nicht Spiele · G sind die gespielten Partien im Zeitraum."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경기 수가 아닌 달력 날짜 기준 · G는 기간 내 출전 경기 수입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按日历天数统计，而非比赛场次 · G 表示该时间段内出场数。"
          }
        }
      }
    },
