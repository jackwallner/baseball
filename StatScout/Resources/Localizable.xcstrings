    "Both sides are %@ in %@. Change one side's season to compare.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both sides are %@ in %@. Change one side's season to compare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos lados tienen a %1$@ en %2$@. Cambia la temporada de uno para comparar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux côtés correspondent à %1$@ en %2$@. Changez la saison d’un côté pour comparer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai selezionato %@ per entrambi, nella stagione %@. Cambia la stagione di uno dei due per confrontarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方とも%2$@年の%1$@です。比較するにはどちらかのシーズンを変更してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dois lados são %1$@ em %2$@. Mude a temporada de um deles para comparar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩邊都是 %1$@ 的 %2$@ 球季資料。請更改其中一邊的球季再比較。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Seiten nutzen %@ in %@. Ändere die Saison einer Seite zum Vergleichen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양쪽 모두 %@에서 %@ 기록을 보고 있습니다. 비교하려면 한쪽 시즌을 바꾸세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两边都是 %@ 的 %@。更改一边的赛季即可比较。"
          }
        }
      }
    },
