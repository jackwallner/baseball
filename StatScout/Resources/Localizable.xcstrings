    "Your StatScout+ access has lapsed. Pick it back up to get the Trends board, recent form, head-to-head matchups, and every past season.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your StatScout+ access has lapsed. Pick it back up to get the Trends board, recent form, head-to-head matchups, and every past season."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu acceso a StatScout+ ha caducado. Retómalo para recuperar el tablero de Tendencias, la forma reciente, los duelos cara a cara y todas las temporadas pasadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre accès à StatScout+ a expiré. Réactivez-le pour retrouver le tableau Tendances, la forme récente, les duels directs et toutes les saisons passées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo accesso a StatScout+ è scaduto. Riattivalo per tornare a consultare la classifica delle tendenze, la forma recente, i confronti diretti e tutte le stagioni passate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "StatScout+の利用期間が終了しました。再開すると、トレンドボード、最近の調子、選手同士の比較、過去のすべてのシーズンが使えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu acesso ao StatScout+ expirou. Retome sua assinatura para ter o quadro de Tendências, a forma recente, os confrontos diretos e todas as temporadas passadas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 StatScout+ 訂閱已到期。重新啟用即可使用趨勢榜、近期表現、正面對決與所有過往球季。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein StatScout+-Zugriff ist abgelaufen. Hol ihn dir zurück und nutze das Trends-Board, die aktuelle Form, direkte Duelle und alle vergangenen Saisons."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "StatScout+ 이용이 만료되었습니다. 다시 구독해 트렌드 보드, 최근 폼, 맞대결, 모든 지난 시즌을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 StatScout+ 权限已过期。重新订阅即可使用趋势榜、近期状态、正面对比和所有过往赛季。"
          }
        }
      }
    },
