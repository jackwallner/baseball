            "value": "Elige un jugador para ver cómo cambiaron sus percentiles en cada temporada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un joueur pour voir l’évolution de ses centiles sur chaque saison."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un giocatore per vedere come sono cambiati i suoi percentili da una stagione all’altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選手を選ぶと、各シーズンのパーセンタイルの推移がわかります。"
          }
        },
        "pt-BR": {
