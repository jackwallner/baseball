    "The league leader and the league trailer on every Statcast metric, side by side, in one board.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The league leader and the league trailer on every Statcast metric, side by side, in one board."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El líder y el último de la liga en cada métrica de Statcast, lado a lado, en un solo tablero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le leader et le dernier de la ligue sur chaque mesure Statcast, côte à côte, dans un seul tableau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ogni metrica Statcast, il migliore e il peggiore della lega, affiancati in un’unica classifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Statcastの全指標で、リーグのトップと最下位を1つのボードに並べて表示。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O líder e o último da liga em cada métrica do Statcast, lado a lado, em um só quadro."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每項 Statcast 指標的聯盟第一與墊底，並排呈現在同一個榜單。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spitzenreiter und Schlusslichter der Liga bei jeder Statcast-Statistik, direkt nebeneinander."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 Statcast 기록에서 리그 선두와 최하위 선수를 나란히 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "并排查看各项 Statcast 指标的联盟领先者和末位球员。"
          }
        }
      }
    },
    "The new Trends board ranks the biggest movers across the league, not just the names already at the top.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new Trends board ranks the biggest movers across the league, not just the names already at the top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo tablero de Tendencias clasifica a quienes más suben o bajan en la liga, no solo a quienes ya están arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouveau tableau Tendances classe les joueurs dont les stats évoluent le plus dans toute la ligue, pas seulement ceux déjà en tête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nuova classifica delle tendenze ordina chi sta salendo o scendendo di più nella lega, non solo i nomi già in cima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいトレンドボードでは、すでに上位にいる選手だけでなく、リーグ全体の選手を成績の変動幅順に表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O novo quadro de Tendências classifica os jogadores pelas maiores variações na liga, não só os nomes que já estão no topo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全新趨勢榜會排出全聯盟變化幅度最大的球員，不只聚焦原本排名前段的球員。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das neue Trends-Board zeigt die größten Veränderungen in der Liga, nicht nur die bekannten Spitzenreiter."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 트렌드 보드에서 상위 선수뿐 아니라 리그 전체에서 기록이 가장 크게 달라진 선수들의 순위를 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全新趋势榜按联盟变化幅度排名，不只关注原本就在榜首的球员。"
          }
        }
      }
    },
